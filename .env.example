# Planned environment contract; no application env loader exists until M0.1.
# Copy to .env only when following docs/DEVELOPMENT.md. Blank secrets are intentional.
# Never expose this entire file through Vite define/envPrefix.

# Bootstrap/runtime (M0.1)
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=info
BUILD_SHA=local

# DB features (M0.2/M3): separate local/test/prod values and least-privilege roles.
DATABASE_URL=
DATABASE_MIGRATION_URL=
TEST_DATABASE_URL=

# Server-only Auth (M3). Google OAuth and Resend SMTP secrets live in Supabase settings.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Privileged account deletion/private storage only; never routine DB access.
SUPABASE_SECRET_KEY=
# Base64-encoded 32 random bytes, not a password; rotation plan required in M3.
SESSION_ENCRYPTION_KEY_BASE64=
SESSION_ENCRYPTION_KEY_ID=

# Private Storage (M3 export / M5 large review evidence); buckets must not be public.
SUPABASE_EXPORT_BUCKET=
SUPABASE_EVIDENCE_BUCKET=

# Optional monitoring; unset means disabled, not fake telemetry success.
SENTRY_DSN=
VITE_SENTRY_DSN=
# Public non-secret build identity only.
VITE_BUILD_SHA=local
# CI release upload only; never passed to app runtime or browser.
SENTRY_AUTH_TOKEN=

# M8 staging/production admission limits require measured values; no invented capacity.
ADMISSION_MAX_CONNECTIONS=
ADMISSION_MAX_RUNNING_MATCHES=
